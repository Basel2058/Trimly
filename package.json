{
  "name": "trimly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-friction barber appointment booking (PWA) on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && vitest run && playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@playwright/test": "1.63.0",
    "http_ece": "^1.2.1",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
